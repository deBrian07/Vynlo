{
  "name": "vynlo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Email, without the friction. A local-first Gmail productivity extension.",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build && node scripts/sync-build.mjs",
    "zip": "wxt zip && node scripts/sync-build.mjs",
    "postinstall": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview:build": "vite build --config tests/preview/vite.config.ts",
    "preview": "vite --config tests/preview/vite.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "preview:static": "vite preview --config tests/preview/vite.config.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "1.61.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "wxt": "0.21.4",
    "@wxt-dev/module-react": "1.2.2",
    "vite": "8.3.5",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "typescript": "6.0.3",
    "eslint": "10.13.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.72.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "vitest": "5.0.5",
    "jsdom": "26.1.0",
    "fake-indexeddb": "^6.2.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@playwright/test": "1.64.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/chrome": "^0.1.24",
    "@types/node": "^22.19.0"
  }
}
