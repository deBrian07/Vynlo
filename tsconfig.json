{
  "extends": "./.wxt/tsconfig.json",
  "exclude": ["**/node_modules", ".output", "artifacts", "release"],
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "react-jsx",
    "types": ["chrome", "node", "vitest/globals"],
    "ignoreDeprecations": "6.0"
  }
}
